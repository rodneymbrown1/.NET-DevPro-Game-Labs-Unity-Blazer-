        <span class="terminal-dot red"></span>
        <span class="terminal-dot yellow"></span>
        <span class="terminal-dot green"></span>
        <span class="terminal-title">devpro@gamelabs: ~/main</span>
    </div>

    <div class="terminal-body">
        <p class="terminal-line boot-1">> INITIALIZING SYSTEM...</p>
        <p class="terminal-line boot-2">> LOADING MODULES... <span class="success">OK</span></p>
        <p class="terminal-line boot-3">> ESTABLISHING CONNECTION... <span class="success">OK</span></p>
        <p class="terminal-line boot-4">> WELCOME TO</p>

        <pre class="ascii-title boot-5">
 ____             ____
|  _ \  _____   _|  _ \ _ __ ___
| | | |/ _ \ \ / / |_) | '__/ _ \
| |_| |  __/\ V /|  __/| | | (_) |
|____/ \___| \_/ |_|   |_|  \___/
  ____                        _          _
 / ___| __ _ _ __ ___   ___  | |    __ _| |__  ___
| |  _ / _` | '_ ` _ \ / _ \ | |   / _` | '_ \/ __|
| |_| | (_| | | | | | |  __/ | |__| (_| | |_) \__ \
 \____|\__,_|_| |_| |_|\___| |_____\__,_|_.__/|___/
        </pre>

        <p class="terminal-line boot-6">> STATUS: <span class="success">ONLINE</span></p>
        <p class="terminal-line boot-7">> SELECT OPTION:</p>

        <div class="menu boot-8">
            <a class="menu-item" href="games">[ PLAY GAMES ]</a>
            <a class="menu-item" href="#about">[ ABOUT ]</a>
            <a class="menu-item" href="#contact">[ CONTACT ]</a>
        </div>

        <p class="terminal-line cursor-line boot-9">
            <span class="prompt">> </span><span class="cursor">_</span>
        </p>
    </div>
</div>

<footer>
    <p>&copy; @DateTime.Now.Year DevPro Game Labs</p>
</footer>
